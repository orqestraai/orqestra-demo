# Local-only configuration for the generated FastAPI application.
# Copy this file to .env before running the backend locally.
PROJECT_NAME="Orqestra Demo"
STACK_NAME=orqestra-demo
DOMAIN=localhost
FRONTEND_HOST=http://localhost:5173
ENVIRONMENT=local
BACKEND_CORS_ORIGINS="http://localhost:5173"

SECRET_KEY=local-demo-secret-change-before-deployment
FIRST_SUPERUSER=demo@example.com
FIRST_SUPERUSER_PASSWORD=local-demo-password

SMTP_HOST=
SMTP_USER=
SMTP_PASSWORD=
EMAILS_FROM_EMAIL=demo@example.com
SMTP_TLS=True
SMTP_SSL=False
SMTP_PORT=587

POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_DB=app
POSTGRES_USER=postgres
POSTGRES_PASSWORD=local-demo-password
# Tests and lightweight demos can override PostgreSQL with SQLite.
# DATABASE_URL=sqlite:///./orqestra-demo.db

SENTRY_DSN=
